# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (RDS endpoint after setup)
DATABASE_URI=postgresql://mohanji:<PASSWORD>@<RDS_ENDPOINT>:5432/mohanji_db

# ─── Payload CMS ───────────────────────────────────────────────────────────────
# Any random 32+ character string — generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace_with_random_32_char_secret

# ─── Next.js ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=https://<YOUR_AMPLIFY_DOMAIN>

# ─── AWS S3 (for media uploads) ────────────────────────────────────────────────
S3_BUCKET=mohanji-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=AKIA...
S3_SECRET_ACCESS_KEY=...
NEXT_PUBLIC_CDN_URL=https://<CLOUDFRONT_DOMAIN>.cloudfront.net

# ─── Email (optional — needed for contact forms) ───────────────────────────────
RESEND_API_KEY=re_...

# ─── Analytics (optional) ──────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
